FASTMCP_STATELESS_HTTP=true

# Configuración de la fábrica de repositorios
# Valores posibles para REPO_TYPE: sqlite (por defecto), json
REPO_TYPE=sqlite

# Rutas opcionales
SQLITE_PATH=students.db
JSON_PATH=students.json

# Puertos
API_PORT=5001
MCP_PORT=9000

# Gemini
GEMINI_API_KEY=tu_token_de_gemini
GEMINI_MODEL=gemini-3.5-flash
